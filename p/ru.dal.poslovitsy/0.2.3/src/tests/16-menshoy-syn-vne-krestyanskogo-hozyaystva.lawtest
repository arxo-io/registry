language "law.core" version "0.2";
package ru.dal.poslovitsy version "0.2.3";
namespace "urn:ru:dal:clir:poslovitsy";

test "urn:query:dp-menshoy-syn-vne-krestyanskogo-hozyaystva" {
    given {
        assert "dp10d-1": menshoy_syn(entity_ref("urn:ru:dal:clir:poslovitsy#Vanka"), entity_ref("urn:ru:dal:clir:poslovitsy#Trofim")) { origin case_input; }
        assert "dp10d-2": nasledstvo_otkrylos(entity_ref("urn:ru:dal:clir:poslovitsy#Trofim")) { origin case_input; }
    }
    evaluate truth(nasleduet_domom(entity_ref("urn:ru:dal:clir:poslovitsy#Vanka"), entity_ref("urn:ru:dal:clir:poslovitsy#Trofim")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
