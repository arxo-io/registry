language "law.core" version "0.2";
package ru.dal.poslovitsy version "0.2.3";
namespace "urn:ru:dal:clir:poslovitsy";

// Родовая ответственность «(стар.)»: в деле был только Фрол, но его брат
// Степан в ответе — не участвуя. Ответ постороннего этот пакет оставляет
// молчанием (см. 03-otvet.law), а ответ брата выводит.
test "urn:query:dp-brat-bratu-golovoy" {
    given {
        assert "dp05-1": v_dele(entity_ref("urn:ru:dal:clir:poslovitsy#Frol"), entity_ref("urn:ru:dal:clir:poslovitsy#DeloODolge")) { origin case_input; }
        assert "dp05-2": brat(entity_ref("urn:ru:dal:clir:poslovitsy#Stepan"), entity_ref("urn:ru:dal:clir:poslovitsy#Frol")) { origin case_input; }
        assert "dp05-3": rodovaya_otvetstvennost_primenima(entity_ref("urn:ru:dal:clir:poslovitsy#DeloODolge")) { origin case_input; }
    }
    evaluate truth(v_otvete(entity_ref("urn:ru:dal:clir:poslovitsy#Stepan"), entity_ref("urn:ru:dal:clir:poslovitsy#DeloODolge")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
