language "law.core" version "0.2";
package ru.dal.poslovitsy version "0.2.1";
namespace "urn:ru:dal:clir:poslovitsy";

// Пойман с поличным: дефитер-факт опрокидывает презумпцию — не чист.
test "urn:query:dp-poyman-prezumptsiya-oprokinuta" {
    given {
        context { decision_time @2026-08-29T12:00:00Z; knowledge_time @2026-08-29T12:00:00Z; legal_time @1879-06-01; timezone "UTC"; }
        assert "dp07-1": podozrevaetsya(entity_ref("urn:ru:dal:clir:poslovitsy#Ereme")) { origin case_input; }
        assert "dp07-2": poyman_s_polichnym(entity_ref("urn:ru:dal:clir:poslovitsy#Ereme")) { origin case_input; }
    }
    evaluate truth(chist_ot_tatby(entity_ref("urn:ru:dal:clir:poslovitsy#Ereme")));
    expect result_kind == PROPOSITION;
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}
