language "law.core" version "0.2";
package ru.dal.poslovitsy version "0.2.1";
namespace "urn:ru:dal:clir:poslovitsy";

test "urn:query:dp-rodovaya-otvetstvennost-bez-starogo-obychaya" {
    given {
        assert "dp05b-1": v_dele(entity_ref("urn:ru:dal:clir:poslovitsy#Frol"), entity_ref("urn:ru:dal:clir:poslovitsy#DeloODolge")) { origin case_input; }
        assert "dp05b-2": brat(entity_ref("urn:ru:dal:clir:poslovitsy#Stepan"), entity_ref("urn:ru:dal:clir:poslovitsy#Frol")) { origin case_input; }
    }
    evaluate truth(v_otvete(entity_ref("urn:ru:dal:clir:poslovitsy#Stepan"), entity_ref("urn:ru:dal:clir:poslovitsy#DeloODolge")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
