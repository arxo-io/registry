language "law.core" version "0.2";
package ru.dal.poslovitsy version "0.2.1";
namespace "urn:ru:dal:clir:poslovitsy";

// Наследство открылось — меньшой сын наследует домом (крестьянская
// ультимогенитура, помета Даля).
test "urn:query:dp-menshoy-syn-na-kornyu" {
    given {
        assert "dp10-1": menshoy_syn(entity_ref("urn:ru:dal:clir:poslovitsy#Vanka"), entity_ref("urn:ru:dal:clir:poslovitsy#Trofim")) { origin case_input; }
        assert "dp10-2": nasledstvo_otkrylos(entity_ref("urn:ru:dal:clir:poslovitsy#Trofim")) { origin case_input; }
        assert "dp10-3": krestyanskoe_domokhozyaystvo(entity_ref("urn:ru:dal:clir:poslovitsy#Trofim")) { origin case_input; }
    }
    evaluate truth(nasleduet_domom(entity_ref("urn:ru:dal:clir:poslovitsy#Vanka"), entity_ref("urn:ru:dal:clir:poslovitsy#Trofim")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
