language "law.core" version "0.2";
package ru.dal.poslovitsy version "0.2.1";
namespace "urn:ru:dal:clir:poslovitsy";

// Холоп свидетельствует против холопа — послух допустим.
test "urn:query:dp-kholop-na-kholopa-poslukh" {
    given {
        assert "dp04-1": kholop(entity_ref("urn:ru:dal:clir:poslovitsy#Grishka")) { origin case_input; }
        assert "dp04-2": kholop(entity_ref("urn:ru:dal:clir:poslovitsy#Miron")) { origin case_input; }
        assert "dp04-3": svidetelstvuet(entity_ref("urn:ru:dal:clir:poslovitsy#Grishka"), entity_ref("urn:ru:dal:clir:poslovitsy#Miron"), entity_ref("urn:ru:dal:clir:poslovitsy#DeloOPotrave")) { origin case_input; }
    }
    evaluate truth(poslukh(entity_ref("urn:ru:dal:clir:poslovitsy#Grishka"), entity_ref("urn:ru:dal:clir:poslovitsy#Miron"), entity_ref("urn:ru:dal:clir:poslovitsy#DeloOPotrave")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
