language "law.core" version "0.2";
package ru.dal.poslovitsy version "0.2.2";
namespace "urn:ru:dal:clir:poslovitsy";

test "urn:query:dp-lezhachego-ne-byut" {
    given {
        context { decision_time @2026-08-31T12:00:00Z; knowledge_time @2026-08-31T12:00:00Z; legal_time @1879-06-01; timezone "UTC"; }
        assert "dp16-1": uchastnik_boya(entity_ref("urn:ru:dal:clir:poslovitsy#Frol"), entity_ref("urn:ru:dal:clir:poslovitsy#KulachnyyBoy")) { origin case_input; }
        assert "dp16-2": lezhachiy(entity_ref("urn:ru:dal:clir:poslovitsy#Savva"), entity_ref("urn:ru:dal:clir:poslovitsy#KulachnyyBoy")) { origin case_input; }
    }
    evaluate positions();
    expect result_kind == NORM_POSITION;
    expect normative_status == ACTIVE;
    expect applicability_status == APPLICABLE;
    expect evaluation_status == COMPUTED;
}
