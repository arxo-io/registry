language "law.core" version "0.2";
package ru.dal.poslovitsy version "0.2.2";
namespace "urn:ru:dal:clir:poslovitsy";

// Подозреваемый, но не пойманный: презумпция держит — чист от татьбы.
test "urn:query:dp-ne-poyman-ne-vor" {
    given {
        context { decision_time @2026-08-29T12:00:00Z; knowledge_time @2026-08-29T12:00:00Z; legal_time @1879-06-01; timezone "UTC"; }
        assert "dp06-1": podozrevaetsya(entity_ref("urn:ru:dal:clir:poslovitsy#Ereme")) { origin case_input; }
    }
    evaluate truth(chist_ot_tatby(entity_ref("urn:ru:dal:clir:poslovitsy#Ereme")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
